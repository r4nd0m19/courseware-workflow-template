{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/style-pack.schema.json",
  "title": "Courseware style pack (full spec)",
  "type": "object",
  "required": ["id", "version", "components", "layouts"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://courseware.local/component-spec.schema.json" }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
