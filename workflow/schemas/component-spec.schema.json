{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/component-spec.schema.json",
  "title": "Courseware component spec",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "status",
    "propsSchema",
    "states",
    "whenToUse",
    "whenNotToUse",
    "learningFunction",
    "accessibility",
    "baseline"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["shell", "cover", "content", "assessment", "interactive", "summary", "variant"]
    },
    "status": {
      "type": "string",
      "enum": ["core", "extended", "experimental", "deprecated"]
    },
    "kind": {
      "type": "string",
      "enum": ["reference", "generated"],
      "description": "reference = implementation copied verbatim from the reference courseware; generated = design vocabulary only, implementation must come from a core registry entry"
    },
    "propsSchema": { "type": "object", "minProperties": 1 },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "whenToUse": { "type": "string", "minLength": 1 },
    "whenNotToUse": { "type": "string", "minLength": 1 },
    "learningFunction": { "type": "string", "minLength": 1 },
    "accessibility": { "type": "object", "minProperties": 1 },
    "baseline": { "type": "string", "minLength": 1 }
  }
}
