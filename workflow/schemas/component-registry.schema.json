{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/component-registry.schema.json",
  "title": "Courseware component registry index",
  "description": "Searchable index of approved component packages. Full component metadata lives in each package component.json.",
  "type": "object",
  "required": ["schemaVersion", "registryId", "version", "stylePack", "components"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "registryId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "stylePack": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "version", "status", "package"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "status": { "type": "string", "enum": ["core", "deprecated"] },
          "package": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
