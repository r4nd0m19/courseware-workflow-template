{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/review-ai-output.schema.json",
  "title": "Single-shot text review model output",
  "description": "Checklist statuses plus optional script density/complexity/concepts. The harness merges this into the deterministic self-review skeleton.",
  "type": "object",
  "additionalProperties": false,
  "required": ["checklist", "issues", "verdict"],
  "properties": {
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["pass", "fail", "n/a"] },
          "notes": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["blocking", "non-blocking"] },
          "fixed": { "type": "boolean" }
        }
      }
    },
    "density": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "semanticUnits", "verdict"],
        "properties": {
          "slideId": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
          "semanticUnits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "evidence"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          },
          "verdict": { "type": "string", "enum": ["pass", "exception", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "complexity": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "verdict"],
        "properties": {
          "slideId": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
          "verdict": { "type": "string", "enum": ["pass", "exception", "fail"] },
          "notes": { "type": "string" }
        }
      }
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conceptId", "verdict", "evidence"],
        "properties": {
          "conceptId": { "type": "string", "pattern": "^C[0-9]{2,}$" },
          "verdict": { "type": "string", "enum": ["pass", "gap"] },
          "evidence": { "type": "string", "minLength": 1 },
          "slideIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
          }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "fail"] }
  }
}
