{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/narration.schema.json",
  "title": "Courseware narration manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "sourceHash",
    "generatedAt",
    "provider",
    "generator",
    "defaults",
    "defaultVoice",
    "voices",
    "slides"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "source": { "type": "string", "minLength": 1 },
    "sourceHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "generator": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "required": ["locale", "rate", "pitch", "outputFormat"],
      "additionalProperties": false,
      "properties": {
        "locale": { "type": "string", "minLength": 1 },
        "rate": { "type": "string", "minLength": 1 },
        "pitch": { "type": "string", "minLength": 1 },
        "outputFormat": { "type": "string", "minLength": 1 }
      }
    },
    "defaultVoice": { "type": "string", "minLength": 1 },
    "voices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "displayName", "providerVoice"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "providerVoice": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 }
        }
      }
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "voice", "url", "bytes", "durationSeconds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "voice": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "bytes": { "type": "number", "minimum": 0 },
          "durationSeconds": { "type": "number", "minimum": 0 }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "rawText", "spokenText", "audio"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rawText": { "type": "string", "minLength": 1 },
          "spokenText": { "type": "string", "minLength": 1 },
          "audio": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
