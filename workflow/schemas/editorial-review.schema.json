{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/editorial-review.schema.json",
  "title": "Script editorial review",
  "description": "Open-ended editorial findings bound to the exact script bytes that were reviewed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "artifactPaths",
    "reviewedArtifacts",
    "summary",
    "findings",
    "verdict",
    "reviewedAt"
  ],
  "properties": {
    "stage": { "type": "string", "enum": ["script-editorial"] },
    "artifactPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "dimension", "severity", "evidence", "suggestion"],
        "properties": {
          "slideId": { "type": "string", "minLength": 1 },
          "dimension": {
            "type": "string",
            "enum": [
              "code-correctness",
              "cross-reference",
              "terminology-sequencing",
              "answer-leakage",
              "objective-alignment",
              "language",
              "practice-coverage",
              "consistency",
              "other"
            ]
          },
          "severity": { "type": "string", "enum": ["blocking", "major", "minor"] },
          "evidence": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "revise"] },
    "reviewedAt": { "type": "string", "minLength": 1 },
    "reviewMeta": { "type": "object" }
  }
}
