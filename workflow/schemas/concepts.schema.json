{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/concepts.schema.json",
  "title": "Core concept ledger",
  "description": "Maps each core concept to the slide that introduces it and the phrases that must be visible on that slide's screen.",
  "type": "object",
  "required": ["schemaVersion", "lesson", "concepts"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lesson": { "type": "string", "minLength": 1 },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "term",
          "definition",
          "introducedOn",
          "mustAppear",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]{2,}$" },
          "term": { "type": "string", "minLength": 1 },
          "definition": {
            "type": "string",
            "minLength": 10,
            "description": "One or two sentences a learner can use to explain the concept."
          },
          "introducedOn": {
            "type": "string",
            "pattern": "^S[0-9]+[A-Z]?$",
            "description": "Slide whose screen must carry the definition."
          },
          "reinforcedOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
          },
          "assessedOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
          },
          "mustAppear": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2 },
            "description": "Key phrases that must appear verbatim (after punctuation/whitespace normalization) in the introducedOn slide's 屏幕内容."
          },
          "evidence": {
            "type": "string",
            "minLength": 10,
            "description": "Observable learner action that shows the concept is understood."
          },
          "sourceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
