{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/self-study-audit.schema.json",
  "title": "Self-study sufficiency audit",
  "description": "Audit of a courseware script: can a student learn from it without a teacher? Gaps carry evidence, a proposal, a basis and an explicit page impact. The audit never changes the script; supplements are applied only after human approval.",
  "type": "object",
  "required": [
    "schemaVersion",
    "lesson",
    "auditVersion",
    "mode",
    "script",
    "contentPack",
    "rubric",
    "objectives",
    "screens",
    "gaps",
    "pageBudget",
    "supplements",
    "verdict",
    "reviewedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "lesson": { "type": "string", "minLength": 1 },
    "auditVersion": { "type": "string", "minLength": 1 },
    "mode": {
      "const": "self-study",
      "description": "This audit is for a student learning without a teacher. Classroom-only deixis is a gap."
    },
    "script": {
      "type": "object",
      "required": ["path", "sha256", "slides"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "slides": { "type": "integer", "minimum": 1 }
      }
    },
    "contentPack": {
      "type": "object",
      "required": ["path", "requiredItems", "referencedItems", "unreferenced"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "requiredItems": { "type": "integer", "minimum": 0 },
        "referencedItems": { "type": "integer", "minimum": 0 },
        "unreferenced": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "name", "verdict", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "objectives",
              "prerequisites",
              "explanation",
              "worked-examples",
              "practice",
              "feedback",
              "misconceptions",
              "navigation",
              "accessibility",
              "self-regulation"
            ]
          },
          "name": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "enum": ["pass", "gap", "n/a"] },
          "evidence": { "type": "string", "minLength": 1 },
          "notes": { "type": "string" }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "explanation", "workedExample", "practice", "feedback", "slides"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "explanation": { "type": "boolean" },
          "workedExample": { "type": "boolean" },
          "practice": { "type": "boolean" },
          "feedback": { "type": "boolean" },
          "slides": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "objectiveIds", "status", "gapIds"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
          "role": {
            "type": "string",
            "enum": ["activate", "explain", "demonstrate", "practice", "assess", "integrate", "summary", "other"]
          },
          "objectiveIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "status": { "type": "string", "enum": ["sufficient", "gap", "waived", "n/a"] },
          "gapIds": {
            "type": "array",
            "items": { "type": "string", "pattern": "^G[0-9]{2,}$" },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "dimension",
          "slideIds",
          "summary",
          "evidence",
          "proposal",
          "basis",
          "pageImpact"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]{2,}$" },
          "severity": { "type": "string", "enum": ["blocking", "recommended", "info"] },
          "dimension": {
            "type": "string",
            "enum": [
              "objectives",
              "prerequisites",
              "explanation",
              "worked-examples",
              "practice",
              "feedback",
              "misconceptions",
              "navigation",
              "accessibility",
              "self-regulation"
            ]
          },
          "slideIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "objectiveIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "summary": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "proposal": { "type": "string", "minLength": 1 },
          "basis": { "type": "string", "minLength": 1 },
          "pageImpact": { "type": "integer" }
        }
      }
    },
    "pageBudget": {
      "type": "object",
      "required": ["declared", "current", "proposed", "exceedsDeclaredBudget", "decision"],
      "additionalProperties": false,
      "properties": {
        "declared": { "type": "integer", "minimum": 1 },
        "current": { "type": "integer", "minimum": 1 },
        "proposed": { "type": "integer", "minimum": 1 },
        "exceedsDeclaredBudget": { "type": "boolean" },
        "decision": { "type": "string", "enum": ["teacher-approval-required", "within-budget"] }
      }
    },
    "supplements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gapId", "type", "targetSlides", "label", "basis", "summary"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]{2,}-[a-z0-9-]+$" },
          "gapId": { "type": "string", "pattern": "^G[0-9]{2,}$" },
          "type": {
            "type": "string",
            "enum": ["explanation", "prerequisite", "worked-example", "check", "feedback", "transition"]
          },
          "targetSlides": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "label": { "const": "自学补充" },
          "basis": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["sufficient", "insufficient"] },
    "reviewedAt": { "type": "string", "minLength": 1 }
  }
}
