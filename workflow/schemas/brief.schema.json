{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/brief.schema.json",
  "title": "Structured teaching brief",
  "description": "Model-authored UbD brief. Node validates it, then renders spec.md and concepts.yml deterministically.",
  "type": "object",
  "required": [
    "lesson",
    "title",
    "audience",
    "duration",
    "scenario",
    "learnerProfile",
    "misconceptions",
    "objectives",
    "concepts",
    "assessments",
    "coverage",
    "nonGoals",
    "sequence",
    "risks",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "lesson": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "duration": { "type": "string", "minLength": 1 },
    "scenario": { "type": "string", "minLength": 1 },
    "learnerProfile": {
      "type": "object",
      "required": ["priorKnowledge", "gaps", "motivation"],
      "additionalProperties": false,
      "properties": {
        "priorKnowledge": { "type": "string", "minLength": 1 },
        "gaps": { "type": "string", "minLength": 1 },
        "motivation": { "type": "string", "minLength": 1 }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "source", "expose", "rebut"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "expose": { "type": "string", "minLength": 1 },
          "rebut": { "type": "string", "minLength": 1 }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "evidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^O[0-9]+$" },
          "text": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["process", "concept"] },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/concept" }
    },
    "assessments": {
      "type": "object",
      "required": ["preTest", "transfer", "delayed"],
      "additionalProperties": false,
      "properties": {
        "preTest": { "type": "string", "minLength": 1 },
        "transfer": { "type": "string", "minLength": 1 },
        "delayed": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["contentId", "kind", "plannedSlides"],
        "additionalProperties": false,
        "properties": {
          "contentId": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" },
          "kind": { "type": "string", "minLength": 1 },
          "plannedSlides": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        }
      }
    },
    "nonGoals": {
      "type": "object",
      "required": ["notCovered", "intentionallyNotDone"],
      "additionalProperties": false,
      "properties": {
        "notCovered": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "intentionallyNotDone": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sequence": { "type": "string", "minLength": 1 },
    "risks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "definitions": {
    "concept": {
      "type": "object",
      "required": [
        "id",
        "term",
        "definition",
        "introducedOn",
        "mustAppear",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C[0-9]{2,}$" },
        "term": { "type": "string", "minLength": 1 },
        "definition": { "type": "string", "minLength": 10 },
        "introducedOn": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
        "reinforcedOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
        },
        "assessedOn": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
        },
        "mustAppear": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "evidence": { "type": "string", "minLength": 10 },
        "sourceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
