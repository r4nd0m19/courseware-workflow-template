{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/self-review.schema.json",
  "title": "AI self-review before human review",
  "type": "object",
  "required": [
    "stage",
    "artifactPaths",
    "reviewedArtifacts",
    "automatedChecks",
    "checklist",
    "issues",
    "verdict",
    "reviewedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "stage": { "type": "string", "minLength": 1 },
    "artifactPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewedArtifacts": {
      "type": "array",
      "minItems": 1,
      "description": "Content-hash binding: the review only vouches for these exact bytes.",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "density": {
      "type": "array",
      "description": "Per-screen segmenting review. Required by check-self-review when --script/--storyboard are supplied.",
      "items": {
        "type": "object",
        "required": ["slideId", "semanticUnits", "signals", "verdict"],
        "additionalProperties": false,
        "properties": {
          "slideId": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
          "semanticUnits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "evidence"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          },
          "signals": {
            "type": "object",
            "required": [
              "contentRefs",
              "tableRows",
              "tableCols",
              "textRows",
              "textBlocks",
              "codeLines",
              "codeBlocks",
              "bulletItems",
              "narrationSentences",
              "narrationChars",
              "screenChars"
            ],
            "additionalProperties": false,
            "properties": {
              "contentRefs": { "type": "integer", "minimum": 0 },
              "tableRows": { "type": "integer", "minimum": 0 },
              "tableCols": { "type": "integer", "minimum": 0 },
              "textRows": { "type": "integer", "minimum": 0 },
              "textBlocks": { "type": "integer", "minimum": 0 },
              "codeLines": { "type": "integer", "minimum": 0 },
              "codeBlocks": { "type": "integer", "minimum": 0 },
              "bulletItems": { "type": "integer", "minimum": 0 },
              "narrationSentences": { "type": "integer", "minimum": 0 },
              "narrationChars": { "type": "integer", "minimum": 0 },
              "screenChars": { "type": "integer", "minimum": 0 }
            }
          },
          "verdict": {
            "type": "string",
            "enum": ["pass", "exception", "fail"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "referenceAdaptation": {
      "type": "string",
      "description": "Free-form AI reasoning: which visible items belong to the reference lesson and what this lesson's equivalent is. No fixed element list. Required by check-self-review for page reviews when --require-reference-adaptation is set."
    },
    "concepts": {
      "type": "array",
      "description": "Per-concept coverage review. Required by check-self-review when --concepts is supplied.",
      "items": {
        "type": "object",
        "required": ["conceptId", "verdict", "evidence"],
        "additionalProperties": false,
        "properties": {
          "conceptId": { "type": "string", "pattern": "^C[0-9]{2,}$" },
          "verdict": { "type": "string", "enum": ["pass", "gap"] },
          "evidence": { "type": "string", "minLength": 1 },
          "slideIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
          }
        }
      }
    },
    "automatedChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "skipped"] },
          "notes": { "type": "string" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "status"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["pass", "fail", "n/a"] },
          "notes": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "severity", "fixed"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["blocking", "non-blocking"] },
          "fixed": { "type": "boolean" }
        }
      }
    },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "reviewedAt": { "type": "string", "minLength": 1 }
  }
}
