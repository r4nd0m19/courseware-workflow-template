{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/page-review-output.schema.json",
  "title": "Single-shot page review model output",
  "description": "The only fields the page-review model may judge. Deterministic fields (signals, hashes, concepts, automated checks) are merged by the harness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["density", "checklist", "issues", "verdict"],
  "properties": {
    "density": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slideId", "semanticUnits", "verdict"],
        "properties": {
          "slideId": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
          "semanticUnits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "evidence"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "evidence": { "type": "string", "minLength": 1 }
              }
            }
          },
          "verdict": {
            "type": "string",
            "enum": ["pass", "exception", "fail"]
          },
          "notes": { "type": "string" }
        }
      }
    },
    "checklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "status"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["pass", "fail", "n/a"] },
          "notes": { "type": "string" }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "severity"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["blocking", "non-blocking"] },
          "fixed": {
            "type": "boolean",
            "description": "Accepted for compatibility but forced to false: this reviewer has no tools and cannot fix files."
          }
        }
      }
    },
    "referenceAdaptation": {
      "type": "string",
      "description": "Optional delta only when the screenshot shows reference-lesson content not covered by the deterministic mapping."
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail"]
    }
  }
}
