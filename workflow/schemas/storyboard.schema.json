{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/storyboard.schema.json",
  "title": "Courseware storyboard",
  "type": "object",
  "required": ["lesson", "slides"],
  "additionalProperties": false,
  "properties": {
    "lesson": { "type": "string", "minLength": 1 },
    "contentPack": { "type": "string" },
    "stylePack": { "type": "string" },
    "script": { "type": "string" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/slide" }
    }
  },
  "definitions": {
    "slide": {
      "type": "object",
      "required": ["id", "title", "objectiveId", "objective", "contentRefs", "components", "layout", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
        "title": { "type": "string", "minLength": 1 },
        "objectiveId": { "type": "string", "pattern": "^O[0-9]+$" },
        "objective": { "type": "string", "minLength": 1 },
        "contentRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z]+[0-9]+$" }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "layout": { "type": "string", "minLength": 1 },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "level", "contentDemand", "learningAction", "evidence", "learningFunction", "staticAlternative"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "level": {
              "type": "string",
              "enum": ["watch", "answer", "modify", "construct", "explain"]
            },
            "contentDemand": { "type": "string", "minLength": 1 },
            "learningAction": {
              "type": "string",
              "enum": ["observe", "locate", "label", "predict", "trace", "convert", "classify", "construct", "modify", "explain"]
            },
            "evidence": { "type": "string", "minLength": 1 },
            "learningFunction": { "type": "string", "minLength": 1 },
            "staticAlternative": { "type": "string", "minLength": 1 },
            "whyStatic": { "type": "string", "minLength": 1 },
            "misconception": { "type": "string" },
            "component": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "level": { "const": "watch" } } },
              "then": {
                "required": ["whyStatic"],
                "properties": { "learningAction": { "const": "observe" } }
              },
              "else": {
                "not": { "required": ["whyStatic"] }
              }
            }
          ]
        },
        "continuedFrom": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" },
        "continued": { "type": "boolean" },
        "status": { "type": "string", "enum": ["DRAFT", "APPROVED", "SKIP"] },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" },
        "scriptSection": { "type": "string" }
      }
    }
  }
}
