{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/style-pack-manifest.schema.json",
  "title": "Courseware style pack manifest",
  "type": "object",
  "required": ["id", "components", "layouts"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["core", "extended", "experimental", "deprecated"] },
          "kind": {
            "type": "string",
            "enum": ["reference", "generated"],
            "description": "reference = implementation copied verbatim from the reference courseware; generated = design vocabulary only, implementation must come from a core registry entry"
          }
        }
      }
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "description": "Layout ids, either bare strings or {id, description} objects (the full style pack and extracted shells use objects).",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["id"],
            "additionalProperties": true,
            "properties": { "id": { "type": "string", "minLength": 1 } }
          }
        ]
      }
    }
  }
}
