{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/component-files.schema.json",
  "title": "Structured component file bundle",
  "description": "Model-authored component files. Node validates paths, writes only to a temporary staging package, and never trusts the model to register the component.",
  "type": "object",
  "required": ["id", "files"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(component\\.json|runtime\\.js|styles\\.css|tests/[A-Za-z0-9._-]+\\.(mjs|js)|stories/[A-Za-z0-9._/-]+\\.(html|css|js)|assets/[A-Za-z0-9._/-]+|baselines/[A-Za-z0-9._-]+\\.(png|jpg|jpeg|webp))$"
          },
          "content": { "type": "string", "minLength": 1 },
          "encoding": { "type": "string", "enum": ["utf8", "base64"], "default": "utf8" }
        },
        "allOf": [
          {
            "not": {
              "properties": {
                "path": { "pattern": "(^|/)\\.\\.(/|$)" }
              }
            }
          }
        ]
      }
    }
  }
}
