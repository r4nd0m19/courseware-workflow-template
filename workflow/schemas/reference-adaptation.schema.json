{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://courseware.local/reference-adaptation.schema.json",
  "title": "Per-lesson reference adaptation map",
  "type": "object",
  "required": ["schemaVersion", "lesson", "shell", "referenceSource", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "lesson": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "referenceSource": { "type": "string", "minLength": 1 },
    "referenceLesson": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "reference", "where", "lesson", "evidence", "pages", "residue"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RA[0-9]{2,}$" },
          "kind": {
            "type": "string",
            "enum": ["text", "code", "label", "image", "prop", "example", "quiz", "table"]
          },
          "reference": { "type": "string", "minLength": 2 },
          "where": { "type": "string", "minLength": 1 },
          "lesson": { "type": "string", "minLength": 1 },
          "lessonText": { "type": "string" },
          "evidence": { "type": "string", "minLength": 1 },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^S[0-9]+[A-Z]?$" }
          },
          "residue": { "type": "string", "enum": ["replace", "allow"] },
          "notes": { "type": "string" }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reference", "reason"],
        "additionalProperties": false,
        "properties": {
          "reference": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "residue": { "type": "string", "enum": ["replace", "allow"] }
        }
      }
    }
  }
}
